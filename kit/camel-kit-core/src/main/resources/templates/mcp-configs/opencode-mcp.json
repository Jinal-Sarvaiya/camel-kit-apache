{
  "$schema": "https://opencode.ai/config.json",
  "permission": {OPENCODE_MCP_PERMISSIONS},
  "mcp": {
    "camel": {
      "type": "local",
      "command": [
        "jbang",
        "--repos", "{CAMEL_MCP_REPOS}",
        "-Dcamel.catalog.repos={CAMEL_CATALOG_REPOS}",
        "-Dquarkus.log.level=WARN",
        "-Dquarkus.http.port=-1",
        "org.apache.camel:camel-jbang-mcp:{CAMEL_MCP_VERSION}:runner"
      ],
      "enabled": true,
      "timeout": 120000
    },
    "camel-knowledge": {
      "type": "local",
      "command": [
        "jbang",
        "--repos", "{KNOWLEDGE_MCP_REPOS}",
        "-Dquarkus.log.level=WARN",
        "{KNOWLEDGE_GROUP_ID}:camel-kit-knowledge-mcp:{KNOWLEDGE_VERSION}:runner"
      ],
      "enabled": true,
      "timeout": 120000
    }{#if CITRUS_ENABLED},
    "citrus": {
      "type": "local",
      "command": [
        "jbang",
        "--repos", "{CITRUS_MCP_REPOS}",
        "-Dquarkus.log.level=WARN",
        "-Dquarkus.http.port=-1",
        "org.citrusframework:citrus-mcp-server:{CITRUS_MCP_VERSION}:runner"
      ],
      "enabled": true,
      "timeout": 120000
    }{/if}
  }
}
