{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/order-event.schema.json",
  "title": "OrderEvent",
  "description": "Event schema for order processing",
  "type": "object",
  "required": ["eventId", "eventType", "timestamp", "payload"],
  "properties": {
    "eventId": {
      "type": "string",
      "description": "Unique event identifier",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "eventType": {
      "type": "string",
      "enum": ["ORDER_CREATED", "ORDER_UPDATED", "ORDER_CANCELLED"],
      "description": "Type of order event"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Event timestamp in ISO 8601 format"
    },
    "payload": {
      "type": "object",
      "description": "Event payload containing order data",
      "required": ["orderId"],
      "properties": {
        "orderId": {
          "type": "string"
        },
        "customerId": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "totalAmount": {
          "type": "number"
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Additional event metadata",
      "properties": {
        "source": {
          "type": "string"
        },
        "correlationId": {
          "type": "string"
        }
      }
    }
  }
}
